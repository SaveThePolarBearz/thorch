From: Thorch contributors
Subject: [PATCH] input: qcom-haptics: calibrate against the board LRA period

The hardcoded Android spec window (185-215 Hz) does not describe this
board's actuator. The Thor reads 170 Hz from SDAM at boot and converges
to 183 Hz on the first calibration pass, 2 Hz under that floor, so the
window always missed, every boot retried three times for nothing, and
every play was then forced to 205 Hz, roughly 20% above the actuator's
resonance.

Derive the window from the board's qcom,lra-period-us instead (Thor:
5880 us, about 170 Hz, plus or minus 10%) and fall back to the board
period rather than the fixed default when calibration still lands
outside it. Reject a zero period before dividing and check the
calibration return code, which the old loop ignored. With the board
window the boot reading is already in range, so no calibration play
runs at boot and the three startup buzzes stay gone (0229).

Ported from linux-thorch 9a4de3ec ("fix: honor board LRA period and
enable runtime protocols").

Fixes: 0229-input-qcom-haptics-drop-lra-boot-cal-retries.patch
---
 drivers/input/misc/qcom-hv-haptics.c | 61 ++++++++++++++++++++--------------------
  1 file changed, 31 insertions(+), 30 deletions(-)
---
--- a/drivers/input/misc/qcom-hv-haptics.c
+++ b/drivers/input/misc/qcom-hv-haptics.c
@@ -361,14 +361,6 @@
 #define DEFAULT_SWEEP_STEP_DURATION_MS		100
 #define DEFAULT_AMPLITUDE_FOR_SWEEP		0xFF
 
-// b/311643110
-// The spec of LRA's f0 is 200 ± 10%
-// But there is a 5 Hz shift in SW value compared to the f0 measured by IMU.
-#define LRA_SPEC_MIN_FREQUENCY 185
-#define LRA_SPEC_MAX_FREQUENCY 215
-#define LRA_SPEC_DEFAULT_FREQUENCY 205
-#define LRA_SPEC_DEFAULT_PERIOD_US (USEC_PER_SEC / LRA_SPEC_DEFAULT_FREQUENCY)
-
 enum hap_status_sel {
 	CAL_TLRA_CL_STS = 0x00,
 	T_WIND_STS,
@@ -3471,7 +3463,8 @@ static int haptics_start_lra_calibrate(struct haptics_chip *chip);
 static int haptics_hw_init(struct haptics_chip *chip)
 {
 	int rc;
-	u32 cl_f_lra;
+	int retry = 0;
+	u32 cl_f_lra, nominal_f_lra, min_f_lra, max_f_lra;
 
 	rc = haptics_config_wa(chip);
 	if (rc < 0)
@@ -3500,29 +3493,37 @@ static int haptics_hw_init(struct haptics_chip *chip)
 	if (rc < 0)
 		return rc;
 	// Workaround for b/339117433 since we can't reproduce it
+	/* Validate against the actuator period supplied by this board, not a
+	 * different actuator's fixed 200-Hz specification. In particular, Thor's
+	 * 5880-us period describes a roughly 170-Hz actuator.
+	 */
+	if (!chip->config.t_lra_us || !chip->config.cl_t_lra_us)
+		return -EINVAL;
+	nominal_f_lra = DIV_ROUND_CLOSEST(USEC_PER_SEC, chip->config.t_lra_us);
+	min_f_lra = nominal_f_lra * 90 / 100;
+	max_f_lra = nominal_f_lra * 110 / 100;
 	cl_f_lra = USEC_PER_SEC / chip->config.cl_t_lra_us;
 	dev_info(chip->dev, "lra frequency detected at boot: %d Hz\n", cl_f_lra);
-/*
-	 * No calibration retry loop here. Upstream re-measures up to three
-	 * times when the SDAM boot reading falls outside the LRA spec
-	 * window, but on the AYN Thor the actuator settles at 183 Hz on
-	 * the first attempt and stays there for every subsequent one.
-	 * That is 2 Hz under the 185 Hz floor, so the loop always ran to
-	 * exhaustion and then fell through to the forced 205 Hz below.
-	 *
-	 * Each attempt is a full-amplitude direct play with a 150 ms
-	 * settle, so the retries were three loud buzzes at every boot for
-	 * no effect on the frequency the motor actually ran at. Only the
-	 * measurement matters, and the measurement is discarded here.
-	 */
-	if (cl_f_lra < LRA_SPEC_MIN_FREQUENCY ||
-			cl_f_lra > LRA_SPEC_MAX_FREQUENCY) {
-		// HACK: forced set the frequency
-		rc = haptics_config_openloop_lra_period(chip, LRA_SPEC_DEFAULT_PERIOD_US);
-		chip->config.cl_t_lra_us = LRA_SPEC_DEFAULT_PERIOD_US;
-		dev_err(chip->dev,
-			"lra frequency is still out of range, forced set to %d Hz, ret: %d\n",
-			LRA_SPEC_DEFAULT_FREQUENCY, rc);
+	while ((cl_f_lra < min_f_lra || cl_f_lra > max_f_lra) &&
+				retry < 3) {
+		rc = haptics_start_lra_calibrate(chip);
+		if (rc < 0)
+			return rc;
+		if (!chip->config.cl_t_lra_us)
+			return -EINVAL;
+		cl_f_lra = USEC_PER_SEC / chip->config.cl_t_lra_us;
+		retry++;
+		dev_info(chip->dev, "frequency after [%d] calibration: %d Hz\n", retry, cl_f_lra);
+	}
+
+	if (cl_f_lra < min_f_lra || cl_f_lra > max_f_lra) {
+		rc = haptics_config_openloop_lra_period(chip, chip->config.t_lra_us);
+		if (rc < 0)
+			return rc;
+		chip->config.cl_t_lra_us = chip->config.t_lra_us;
+		dev_warn(chip->dev,
+			 "LRA calibration outside %u-%u Hz; using board period %u us\n",
+			 min_f_lra, max_f_lra, chip->config.t_lra_us);
 	}
 
 	rc = haptics_init_preload_pattern_effect(chip);
