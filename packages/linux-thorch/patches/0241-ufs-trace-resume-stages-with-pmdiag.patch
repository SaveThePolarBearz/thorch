From: Thorch contributors
Subject: [PATCH] ufs: trace the resume stages with PMDIAG dev_dbg

The overnight s2idle wedge leaves no evidence: the journal stops at
"PM: suspend entry" / "Filesystems sync", and the post-resume path that
never completes is invisible. Tag the UFS and ICE resume sequencing with
"PMDIAG" dev_dbg lines so dyndbg can switch them on at runtime with
"format \"PMDIAG\" +p", ordered begin/end around every step that can
block (vendor resume, hibern8 exit, reset/restore, power mode, timestamp,
bkops, clock scaling, auto-hibern8, the final release) plus the crypto
key reprogram and the ICE clock/BIST resume.

Next to the last completed step in the log, that names the call that
stalled.

Ported from linux-thorch 37b1085f ("debug: trace Thor UFS and ICE resume
stages"), minus the TME broadcast tracing that belongs to a module this
tree does not carry. Tested by inspection only; the vendor kernel tree is
not part of this repository.
---
 drivers/soc/qcom/ice.c           | 11 ++++++++++-
 drivers/ufs/core/ufshcd-crypto.c | 2 ++
 drivers/ufs/core/ufshcd.c        | 21 +++++++++++++++++++++
 drivers/ufs/host/ufs-qcom.c      | 16 ++++++++++++++--
  4 files changed, 47 insertions(+), 3 deletions(-)
---
--- a/drivers/soc/qcom/ice.c
+++ b/drivers/soc/qcom/ice.c
@@ -382,26 +382,35 @@ int qcom_ice_resume(struct qcom_ice *ice)
 	struct device *dev = ice->dev;
 	int err;
 
+	dev_dbg(dev, "PMDIAG ice resume core-clock begin\n");
 	err = clk_prepare_enable(ice->core_clk);
+	dev_dbg(dev, "PMDIAG ice resume core-clock end ret=%d\n", err);
 	if (err) {
 		dev_err(dev, "Failed to enable core clock: %d\n", err);
 		return err;
 	}
 
+	dev_dbg(dev, "PMDIAG ice resume iface-clock begin\n");
 	err = clk_prepare_enable(ice->iface_clk);
+	dev_dbg(dev, "PMDIAG ice resume iface-clock end ret=%d\n", err);
 	if (err) {
 		dev_err(dev, "Failed to enable iface clock: %d\n", err);
 		clk_disable_unprepare(ice->core_clk);
 		return err;
 	}
 	err = qcom_ice_hwkm_init(ice);
-	if (!err)
+	dev_dbg(dev, "PMDIAG ice resume hwkm end ret=%d\n", err);
+	if (!err) {
+		dev_dbg(dev, "PMDIAG ice resume bist begin\n");
 		err = qcom_ice_wait_bist_status(ice);
+		dev_dbg(dev, "PMDIAG ice resume bist end ret=%d\n", err);
+	}
 	if (err) {
 		ice->hwkm_init_complete = false;
 		clk_disable_unprepare(ice->iface_clk);
 		clk_disable_unprepare(ice->core_clk);
 	}
+	dev_dbg(dev, "PMDIAG ice resume end ret=%d\n", err);
 	return err;
 }
 EXPORT_SYMBOL_GPL(qcom_ice_resume);
--- a/drivers/ufs/core/ufshcd-crypto.c
+++ b/drivers/ufs/core/ufshcd-crypto.c
@@ -110,7 +110,9 @@ bool ufshcd_crypto_enable(struct ufs_hba *hba)
 		return false;
 
 	/* Reset might clear all keys, so reprogram all the keys. */
+	dev_dbg(hba->dev, "PMDIAG crypto reprogram-all begin\n");
 	blk_crypto_reprogram_all_keys(&hba->crypto_profile);
+	dev_dbg(hba->dev, "PMDIAG crypto reprogram-all end\n");
 
 	if (hba->quirks & UFSHCD_QUIRK_BROKEN_CRYPTO_ENABLE)
 		return false;
--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -10605,13 +10605,17 @@ static int __ufshcd_wl_resume(struct ufs_hba *hba, enum ufs_pm_op pm_op)
 	enum uic_link_state old_link_state = hba->uic_link_state;
 
 	hba->pm_op_in_progress = true;
+	dev_dbg(hba->dev, "PMDIAG wl resume begin op=%d link=%d power=%d\n",
+		pm_op, hba->uic_link_state, hba->curr_dev_pwr_mode);
 
 	/*
 	 * Call vendor specific resume callback. As these callbacks may access
 	 * vendor specific host controller register space call them when the
 	 * host clocks are ON.
 	 */
+	dev_dbg(hba->dev, "PMDIAG wl vendor-resume begin\n");
 	ret = ufshcd_vops_resume(hba, pm_op);
+	dev_dbg(hba->dev, "PMDIAG wl vendor-resume end ret=%d\n", ret);
 	if (ret)
 		goto out;
 
@@ -10628,7 +10632,9 @@ static int __ufshcd_wl_resume(struct ufs_hba *hba, enum ufs_pm_op pm_op)
 	WARN_ON(ufshcd_is_ufs_dev_deepsleep(hba) && !ufshcd_is_link_off(hba));
 
 	if (ufshcd_is_link_hibern8(hba)) {
+		dev_dbg(hba->dev, "PMDIAG wl hibern8-exit begin\n");
 		ret = ufshcd_uic_hibern8_exit(hba);
+		dev_dbg(hba->dev, "PMDIAG wl hibern8-exit end ret=%d\n", ret);
 		if (!ret) {
 			ufshcd_set_link_active(hba);
 		} else {
@@ -10651,7 +10657,9 @@ static int __ufshcd_wl_resume(struct ufs_hba *hba, enum ufs_pm_op pm_op)
 		 * Note, in the case of DeepSleep, the device will exit
 		 * DeepSleep due to device reset.
 		 */
+		dev_dbg(hba->dev, "PMDIAG wl reset-restore begin\n");
 		ret = ufshcd_reset_and_restore(hba);
+		dev_dbg(hba->dev, "PMDIAG wl reset-restore end ret=%d\n", ret);
 		/*
 		 * ufshcd_reset_and_restore() should have already
 		 * set the link state as active
@@ -10661,14 +10669,19 @@ static int __ufshcd_wl_resume(struct ufs_hba *hba, enum ufs_pm_op pm_op)
 	}
 
 	if (!ufshcd_is_ufs_dev_active(hba)) {
+		dev_dbg(hba->dev, "PMDIAG wl active-power begin\n");
 		ret = ufshcd_set_dev_pwr_mode(hba, UFS_ACTIVE_PWR_MODE);
+		dev_dbg(hba->dev, "PMDIAG wl active-power end ret=%d\n", ret);
 		if (ret)
 			goto set_old_link_state;
+		dev_dbg(hba->dev, "PMDIAG wl timestamp begin\n");
 		ufshcd_set_timestamp_attr(hba);
+		dev_dbg(hba->dev, "PMDIAG wl timestamp end\n");
 		schedule_delayed_work(&hba->ufs_rtc_update_work,
 				      msecs_to_jiffies(UFS_RTC_UPDATE_INTERVAL_MS));
 	}
 
+	dev_dbg(hba->dev, "PMDIAG wl bkops begin\n");
 	if (ufshcd_keep_autobkops_enabled_except_suspend(hba))
 		ufshcd_enable_auto_bkops(hba);
 	else
@@ -10678,9 +10691,11 @@ static int __ufshcd_wl_resume(struct ufs_hba *hba, enum ufs_pm_op pm_op)
 		 */
 		ufshcd_bkops_ctrl(hba);
 
+	dev_dbg(hba->dev, "PMDIAG wl bkops end; ee-control begin\n");
 	if (hba->ee_usr_mask)
 		ufshcd_write_ee_control(hba);
 
+	dev_dbg(hba->dev, "PMDIAG wl ee-control end; clkscaling begin\n");
 	if (ufshcd_is_clkscaling_supported(hba))
 		ufshcd_clk_scaling_suspend(hba, false);
 
@@ -10689,7 +10704,9 @@ static int __ufshcd_wl_resume(struct ufs_hba *hba, enum ufs_pm_op pm_op)
 		cancel_delayed_work(&hba->rpm_dev_flush_recheck_work);
 	}
 
+	dev_dbg(hba->dev, "PMDIAG wl auto-hibern8 begin\n");
 	ufshcd_configure_auto_hibern8(hba);
+	dev_dbg(hba->dev, "PMDIAG wl auto-hibern8 end\n");
 
 	goto out;
 
@@ -10710,9 +10727,13 @@ static int __ufshcd_wl_resume(struct ufs_hba *hba, enum ufs_pm_op pm_op)
 	 * now-runnable threaded handler drains any remaining IS and unmasks the line.
 	 */
 	hba->pm_op_in_progress = false;
+	dev_dbg(hba->dev, "PMDIAG wl poller-stop begin ret=%d\n", ret);
 	timer_delete_sync(&hba->pm_poll_timer);
+	dev_dbg(hba->dev, "PMDIAG wl poller-stop end; release begin\n");
 	hba->clk_gating.is_suspended = false;
 	ufshcd_release(hba);
+	dev_dbg(hba->dev, "PMDIAG wl resume end ret=%d link=%d power=%d\n",
+		ret, hba->uic_link_state, hba->curr_dev_pwr_mode);
 	return ret;
 }
 
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -250,7 +250,9 @@ static int ufs_qcom_ice_keyslot_program(struct blk_crypto_profile *profile,
 	int err;
 
 	ufshcd_hold(hba);
+	dev_dbg(hba->dev, "PMDIAG keyslot program begin slot=%u\n", slot);
 	err = qcom_ice_program_key(host->ice, slot, key);
+	dev_dbg(hba->dev, "PMDIAG keyslot program end slot=%u ret=%d\n", slot, err);
 	ufshcd_release(hba);
 	return err;
 }
@@ -811,7 +813,9 @@ static int ufs_qcom_resume(struct ufs_hba *hba, enum ufs_pm_op pm_op)
 	int err;
 	u32 reg_val;
 
+	dev_dbg(hba->dev, "PMDIAG qcom resume lane-clocks begin op=%d\n", pm_op);
 	err = ufs_qcom_enable_lane_clks(host);
+	dev_dbg(hba->dev, "PMDIAG qcom resume lane-clocks end ret=%d\n", err);
 	if (err)
 		return err;
 
@@ -832,7 +836,10 @@ static int ufs_qcom_resume(struct ufs_hba *hba, enum ufs_pm_op pm_op)
 		ufshcd_readl(hba, UFS_MEM_ICE_CFG);
 	}
 
-	return ufs_qcom_ice_resume(host);
+	dev_dbg(hba->dev, "PMDIAG qcom resume ice begin\n");
+	err = ufs_qcom_ice_resume(host);
+	dev_dbg(hba->dev, "PMDIAG qcom resume ice end ret=%d\n", err);
+	return err;
 }
 
 static int ufs_qcom_fw_managed_suspend(struct ufs_hba *hba, enum ufs_pm_op pm_op,
@@ -853,13 +860,18 @@ static int ufs_qcom_fw_managed_resume(struct ufs_hba *hba, enum ufs_pm_op pm_op)
 	struct ufs_qcom_host *host = ufshcd_get_variant(hba);
 	int err;
 
+	dev_dbg(hba->dev, "PMDIAG firmware resume runtime-get begin\n");
 	err = pm_runtime_resume_and_get(hba->dev);
+	dev_dbg(hba->dev, "PMDIAG firmware resume runtime-get end ret=%d\n", err);
 	if (err) {
 		dev_err(hba->dev, "PM runtime resume failed: %d\n", err);
 		return err;
 	}
 
-	return ufs_qcom_ice_resume(host);
+	dev_dbg(hba->dev, "PMDIAG firmware resume ice begin\n");
+	err = ufs_qcom_ice_resume(host);
+	dev_dbg(hba->dev, "PMDIAG firmware resume ice end ret=%d\n", err);
+	return err;
 }
 
 static void ufs_qcom_dev_ref_clk_ctrl(struct ufs_qcom_host *host, bool enable)
